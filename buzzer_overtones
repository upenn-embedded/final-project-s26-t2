#define F_CPU 16000000UL
#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>

// ??? Tone Frequencies (OCR0A values) ????????????????????????????????????????
// f = F_CPU / (2 x Prescaler x (OCR0A + 1))
// Prescaler = 256

#define SHOT_TONE    5     // ~968 Hz  ? sharp, high crack
#define HIT_TONE     124    // ~250 Hz  ? low, heavy thud
#define RELOAD_TONE  70     // ~440 Hz  ? mid, mechanical click (A4)

// ??? Tone Duration (ms) ?????????????????????????????????????????????????????
#define SHOT_MS      80     // very short burst
#define HIT_MS       300    // longer, heavy feel
#define RELOAD_MS    150    // medium, mechanical feel

// ??? Helper Functions ????????????????????????????????????????????????????????

void tone_start(uint8_t ocr_val)
{
    TCNT0 = 0;
    OCR0A   = ocr_val;
    TCCR0A |= (1 << COM0A0);   // re-enable hardware toggle on OC0A
}

void tone_stop(void)
{
    TCCR0A &= ~((1 << COM0A1) | (1 << COM0A0));  // disconnect OC0A, stops toggling
    PORTD  &= ~(1 << PD6);     // drive pin LOW (silent)
    TCNT0 = 0; //clear timer
}

// ??? Load Events ?????????????????????????????????????????????????????????????

void event_SHOT(void)
{
    tone_start(SHOT_TONE);
    _delay_ms(SHOT_MS);
    tone_stop();
}

void event_HIT(void)
{
    tone_start(HIT_TONE);
    _delay_ms(HIT_MS);
    tone_stop();
}

void event_RELOAD(void)
{
    // 3-click mechanical sequence: click ? pause ? click ? pause ? clunk
    tone_start(RELOAD_TONE);
    _delay_ms(80);
    tone_stop();
    _delay_ms(60);

    tone_start(RELOAD_TONE);
    _delay_ms(80);
    tone_stop();
    _delay_ms(60);

    tone_start(HIT_TONE);       // low clunk at the end
    _delay_ms(120);
    tone_stop();
}

// ??? Initialize ??????????????????????????????????????????????????????????????

void Initialize(void)
{
    cli();

    DDRD |= (1 << DDD6);           // PD6 (OC0A) as output

    // Prescaler = 256
    TCCR0B &= ~(1 << CS00);
    TCCR0B &= ~(1 << CS01);
    TCCR0B |=  (1 << CS02);

    // CTC Mode
    TCCR0A &= ~(1 << WGM00);
    TCCR0A |=  (1 << WGM01);
    TCCR0B &= ~(1 << WGM02);

    // Toggle OC0A on Compare Match
//    TCCR0A |=  (1 << COM0A0);
    TCCR0A &= ~(1 << COM0A1);

    OCR0A = RELOAD_TONE;            // default tone

    sei();
}

